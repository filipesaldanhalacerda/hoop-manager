<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Title>Dev Access Center</Title>
    <Product>Dev Access Center</Product>
    <AssemblyName>DevAccessCenter</AssemblyName>
    <VersionPrefix>1.0.0</VersionPrefix>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Description>Ferramenta interna para gerenciamento de conexões de desenvolvimento.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <!-- Script oficial de instalação do Hoop, embutido para o assistente poder
         instalar sem depender de o desenvolvedor baixar o arquivo antes. -->
    <EmbeddedResource Include="Resources\Scripts\install-hoop.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
