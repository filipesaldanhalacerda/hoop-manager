<UserControl x:Class="HoopConnectionManager.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1050">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="TELEMETRIA LOCAL" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Registro de atividades" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="Acompanhe conexões, autenticação, reconexões e falhas em tempo real. Nenhuma credencial é registrada."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding OpenLogsFolderCommand}"
                    Style="{StaticResource SecondaryButton}" ToolTip="Abrir arquivos de diagnóstico no Windows">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="Abrir pasta de logs" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}"
                             Padding="38,9,34,9" ToolTip="Buscar no conteúdo dos logs" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               FontSize="15" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText.Length, Converter={StaticResource CountToInvertedVisibilityConverter}}"
                            Style="{StaticResource NavigationButton}" Padding="7" HorizontalAlignment="Right" ToolTip="Limpar busca">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                    </Button>
                </Grid>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                          Style="{StaticResource FluentComboBox}" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="HORA" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="NÍVEL" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="ATIVIDADE" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{Binding FilteredEntries}" Style="{StaticResource FluentListView}"
                          ItemContainerStyle="{StaticResource FluentListViewItem}" FontFamily="{DynamicResource MonoFontFamily}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="12" />
                                    <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="4" Padding="7,2" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding LevelLabel}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="9" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}"
                                               TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding FilteredEntries.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{DynamicResource ForegroundSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum evento encontrado" Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,12,2,0">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
            <TextBlock Text="ATUALIZAÇÃO AO VIVO" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
        </Grid>
    </Grid>
</UserControl>
