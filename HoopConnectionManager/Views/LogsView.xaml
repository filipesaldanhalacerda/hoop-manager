<UserControl x:Class="HoopConnectionManager.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1050">
    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LogBadge" TargetType="Border">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <!-- O título dizia "Sessions", que é a outra tela do menu. -->
                <TextBlock Text="OPERAÇÃO LOCAL" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Logs" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="Acompanhe a operação local do Hoop em tempo real. Credenciais e tokens nunca aparecem aqui."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenLogsFolderCommand}"
                    Style="{StaticResource SecondaryButton}" Padding="13,8" ToolTip="Abrir os arquivos completos no Windows">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xED25;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="Pasta de logs" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="ESPAÇO UTILIZADO" Style="{StaticResource EyebrowText}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StorageUsed}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="ARQUIVOS" Style="{StaticResource EyebrowText}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LogFileCount}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="REGISTRO MAIS ANTIGO" Style="{StaticResource EyebrowText}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding OldestLogDate}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="Reter por" Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding SelectedRetentionDays}"
                              Style="{StaticResource FluentComboBox}" Width="68" />
                    <TextBlock Text="dias" Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
                <Button Grid.Column="4" Content="Limpar logs antigos" Command="{Binding ClearOldLogsCommand}"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                             CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Buscar por conexão, ação ou mensagem..." IsHitTestVisible="False"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Style="{StaticResource NavigationButton}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="0" Margin="4">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12" HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,11,0,0">
                <TextBlock Text="Filtrar por" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0,12,0" />
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="Todos">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterChip}"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLevel}" Value="Todos"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                    <TextBlock><Run Text="Todos  "/><Run Text="{Binding Entries.Count, Mode=OneWay}" /></TextBlock>
                </Button>
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="INFO">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterChip}"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLevel}" Value="INFO"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                    <TextBlock><Run Text="Informações  "/><Run Text="{Binding InfoCount, Mode=OneWay}" /></TextBlock>
                </Button>
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="WARN">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterChip}"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLevel}" Value="WARN"><Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                    <TextBlock><Run Text="Alertas  "/><Run Text="{Binding WarningCount, Mode=OneWay}" /></TextBlock>
                </Button>
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="ERROR">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterChip}"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLevel}" Value="ERROR"><Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                    <TextBlock><Run Text="Erros  "/><Run Text="{Binding ErrorCount, Mode=OneWay}" /></TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="HORA" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="NÍVEL" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="2" Text="ATIVIDADE" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                    </Grid>
                </Border>
                <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{Binding FilteredEntries}" Style="{StaticResource FluentListView}"
                          ItemContainerStyle="{StaticResource FluentListViewItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" Margin="0,3,0,0" />
                                <Border Grid.Column="1" Style="{StaticResource LogBadge}">
                                    <TextBlock Text="{Binding LevelLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="9" FontWeight="Bold">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}"
                                           FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap" FontSize="11" LineHeight="17" />
                            </Grid>
                        </Border>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding FilteredEntries.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource EmptyStateGlyph}" />
                    <TextBlock Text="Nenhum evento corresponde aos filtros" Style="{StaticResource EmptyStateTitle}" />
                    <TextBlock Text="Ajuste a busca ou escolha outro nível para ver mais registros." Style="{StaticResource EmptyStateText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="2,11,2,0">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                <TextBlock Text="Atualização ao vivo" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" /></StackPanel>
        </Grid>
    </Grid>
</UserControl>
