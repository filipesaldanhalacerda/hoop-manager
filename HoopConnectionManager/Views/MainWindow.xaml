<Window x:Class="HoopConnectionManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dev Access Center"
        Height="780" Width="1320" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Style="{StaticResource FluentWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,5,32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" HorizontalAlignment="Left" CornerRadius="8"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="DA" Foreground="{DynamicResource NavigationForegroundBrush}"
                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DEV ACCESS" Foreground="{DynamicResource NavigationForegroundBrush}"
                                   FontFamily="{DynamicResource DisplayFontFamily}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="INTERNAL CENTER" Foreground="{DynamicResource NavigationMutedBrush}"
                                   FontSize="8" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="OPERAÇÃO" Foreground="{DynamicResource NavigationMutedBrush}"
                               FontSize="10" FontWeight="SemiBold" Margin="14,0,0,8" />
                    <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="32" />
                            <TextBlock Text="Resources" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateToLogsCommand}" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="32" />
                            <TextBlock Text="Sessions" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="32" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" CornerRadius="8" Padding="14" Background="{DynamicResource NavigationSurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="APLICATIVO ATIVO" Foreground="{DynamicResource SuccessBrush}" FontSize="9" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource NavigationMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}">
                <Grid Margin="32,0">
                    <TextBlock Text="Dev Access Center  /  Ferramenta interna de conexões" Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
                    <Button Command="{Binding ShowSecurityDetailsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource NavigationButton}" Padding="10,7" ToolTip="Entenda como seus dados são protegidos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Integração local segura" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="36,30,36,32" />
        </Grid>

        <Border Grid.Column="1" Panel.ZIndex="20" Width="430" MinHeight="64" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Padding="14,11" Background="{DynamicResource ElevatedBrush}" BorderThickness="4,1,1,1"
                CornerRadius="8" Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotificationKind}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding NotificationKind}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding NotificationGlyph}" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Top" Margin="1,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}" Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap" LineHeight="19" VerticalAlignment="Center" />
                <Button Grid.Column="2" Command="{Binding DismissNotificationCommand}" Style="{StaticResource NavigationButton}"
                        Padding="0" Margin="2" ToolTip="Fechar aviso">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="2" Panel.ZIndex="40"
              Visibility="{Binding IsSecurityDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#99070B14" />
            <Border Width="590" MaxHeight="610" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource SuccessSurfaceBrush}"
                                BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Integração local segura" Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Como o aplicativo protege o acesso aos bancos" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding HideSecurityDetailsCommand}" Style="{StaticResource NavigationButton}"
                                Padding="0" ToolTip="Fechar">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,24,0,24">
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="01  TÚNEL RESTRITO À SUA MÁQUINA" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="Cada banco recebe uma porta exclusiva no endereço local 127.0.0.1. O acesso não é publicado como um serviço aberto na rede."
                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" /></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="02  ACESSO CONTROLADO PELO HOOP" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="O aplicativo usa o Hoop CLI instalado e autenticado pela companhia. O Hoop continua responsável por autorizar a sessão e transportar a conexão até o recurso permitido."
                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" /></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="03  CREDENCIAIS TEMPORÁRIAS PROTEGIDAS" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="A senha permanece oculta na interface, é mantida somente durante o túnel e é removida dos registros. Ao copiar, a limpeza automática da área de transferência respeita sua configuração."
                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" /></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="16,14">
                            <StackPanel><TextBlock Text="04  SEM INTERCEPTAR O BANCO" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="O gerenciador coordena o túnel e entrega o endpoint local ao DBeaver; ele não lê consultas, resultados ou o conteúdo trafegado na sessão do banco."
                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" /></StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <TextBlock Text="A duração e as permissões da sessão seguem as políticas configuradas no Hoop."
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                        <Button Content="Entendi" Command="{Binding HideSecurityDetailsCommand}" Style="{StaticResource FluentButton}"
                                HorizontalAlignment="Right" Padding="18,8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
