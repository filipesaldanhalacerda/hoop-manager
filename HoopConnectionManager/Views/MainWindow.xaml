<Window x:Class="HoopConnectionManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HoopConnectionManager.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="700"
        Width="1200"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Style="{StaticResource FluentWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,32,24,24">
                    <TextBlock Text="Hoop"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="Connection Manager"
                               FontSize="12"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button Content="Dashboard"
                            Command="{Binding NavigateToDashboardCommand}"
                            Style="{StaticResource FluentButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8" />

                    <Button Content="Configurações"
                            Command="{Binding NavigateToSettingsCommand}"
                            Style="{StaticResource FluentButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="24">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área de conteúdo -->
        <Border Grid.Column="1"
                Background="{DynamicResource BackgroundBrush}">
            <ContentControl Content="{Binding CurrentViewModel}"
                            Margin="24" />
        </Border>
    </Grid>
</Window>
