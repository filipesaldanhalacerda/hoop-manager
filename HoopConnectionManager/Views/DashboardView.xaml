<UserControl x:Class="HoopConnectionManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}" />

        <DataTemplate x:Key="ActiveTunnelTemplate">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1,1,1,3"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,12,12"
                    Width="330">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding EnvironmentGroup}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#243D2B" CornerRadius="10" Padding="9,4">
                            <TextBlock Text="ATIVO" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="7" Padding="12" Margin="0,14,0,12">
                        <StackPanel>
                            <TextBlock Text="ENDPOINT LOCAL" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding LocalEndpoint}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="USUÁRIO" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding Username}" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="INICIADO EM" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ConnectedAt, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel>
                        <Button Content="Copiar porta"
                                Command="{Binding DataContext.CopyPortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource FluentButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Copiar senha"
                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource FluentButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Desconectar"
                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource DangerButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ConnectionRowTemplate">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AMBIENTE" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding EnvironmentGroup}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="STATUS" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConnectionStateLabel}" Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="PORTA LOCAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding LocalEndpoint}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Conectar"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanConnect}"
                                Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource FluentButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Desconectar"
                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanDisconnect}"
                                Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CENTRAL OPERACIONAL" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Central de conexões" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="Túneis Hoop e endpoints locais em tempo real"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Atualizar conexões" Command="{Binding LoadConnectionsCommand}"
                    Style="{StaticResource FluentButton}" VerticalAlignment="Center" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="CONEXÕES DISPONÍVEIS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TotalConnections}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="TÚNEIS ATIVOS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding ConnectedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18">
                <StackPanel><TextBlock Text="ESTADO OPERACIONAL" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding OperationalStatus}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,0" /></StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Bancos conectados" Style="{StaticResource SectionTitle}" />
                    <TextBlock HorizontalAlignment="Right" Text="Cada túnel usa uma porta local exclusiva"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" VerticalAlignment="Bottom" />
                </Grid>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,16"
                        Visibility="{Binding ActiveConnections.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <TextBlock Text="Nenhum banco conectado. Escolha uma conexão abaixo para abrir o primeiro túnel."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" HorizontalAlignment="Center" />
                </Border>

                <ItemsControl ItemsSource="{Binding ActiveConnections}"
                              ItemTemplate="{StaticResource ActiveTunnelTemplate}"
                              Visibility="{Binding ActiveConnections.Count, Converter={StaticResource CountToInvertedVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid Margin="0,8,0,10">
                    <TextBlock Text="Todas as conexões" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <TextBox Width="320" HorizontalAlignment="Right"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FluentTextBox}"
                             ToolTip="Pesquisar por nome ou ambiente" />
                </Grid>

                <ListView ItemsSource="{Binding FilteredConnections}"
                          ItemTemplate="{StaticResource ConnectionRowTemplate}"
                          Style="{StaticResource FluentListView}"
                          ItemContainerStyle="{StaticResource FluentListViewItem}">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12" FontWeight="Bold" Margin="2,12,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
