<UserControl x:Class="HoopConnectionManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}" />

        <Style x:Key="GuideFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GuideFieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GuideCopyButton" TargetType="Button" BasedOn="{StaticResource NavigationButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="ToolTip" Value="Copiar" />
        </Style>

        <Style x:Key="GuideStepBadge" TargetType="Border">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="GuideStepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GuideStepText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Margin" Value="11,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="ActiveTunnelTemplate">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,13"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="178" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Degraded">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EnvironmentGroup}" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="  •  " Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="10" />
                            <TextBlock Text="{Binding ConnectionStateLabel}" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       FontSize="10" FontWeight="SemiBold" ToolTip="{Binding StatusDetail}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="ENDPOINT LOCAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding LocalEndpoint}" Foreground="{DynamicResource ForegroundBrush}"
                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="USUÁRIO" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Username}" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="DESDE" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConnectedAt, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="4,0,10,0">
                        <TextBlock Text="SENHA TEMPORÁRIA" Style="{StaticResource MetricLabel}" />
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Height="32" Margin="0,3,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PasswordDisplay}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="9,0,4,0" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{Binding TogglePasswordVisibilityCommand}" ToolTip="Exibir ou ocultar senha"
                                        Style="{StaticResource NavigationButton}" Padding="0" Margin="1">
                                    <TextBlock Text="{Binding PasswordVisibilityGlyph}" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2" ToolTip="Copiar senha temporária"
                                        Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource NavigationButton}" Padding="0" Margin="1">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Dados" ToolTip="Ver e copiar os dados para criar a conexão no DBeaver"
                                Command="{Binding DataContext.ShowConnectionGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,6,0" />
                        <Button Content="Desconectar" ToolTip="Encerrar este túnel"
                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource DangerButton}" Padding="11,7" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ConnectionRowTemplate">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,14"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="17" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AMBIENTE" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding EnvironmentGroup}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="STATUS" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConnectionStateLabel}" Foreground="{DynamicResource ForegroundBrush}"
                                   ToolTip="{Binding StatusDetail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="PORTA LOCAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding LocalEndpoint}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Conectar"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanConnect}"
                                Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Desconectar"
                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanDisconnect}"
                                Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CENTRAL DE CONEXÕES" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Resources" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="Conecte bancos autorizados usando túneis locais seguros."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <!-- O distintivo seguia o estilo de sucesso mesmo ao anunciar falha de
                 sincronização; agora a cor acompanha CatalogSyncState. -->
            <Border Grid.Column="1" CornerRadius="14" BorderThickness="1" Padding="12,7" VerticalAlignment="Center"
                    ToolTip="{Binding CatalogSyncStatus}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CatalogSyncState}" Value="Ok">
                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CatalogSyncState}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource IconFontFamily}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE895;" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CatalogSyncState}" Value="Ok">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CatalogSyncState}" Value="Error">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CatalogSyncStatus}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CatalogSyncState}" Value="Ok">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CatalogSyncState}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Enquanto o ambiente não estiver completo, o caminho de volta ao assistente
             fica visível na tela principal. Antes, quem concluísse o onboarding uma vez
             nunca mais conseguia reabri-lo. -->
        <Border Grid.Row="1" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,18"
                Visibility="{Binding HasPendingSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource WarningBrush}"
                           FontSize="17" VerticalAlignment="Center" Margin="0,0,13,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ambiente ainda não está completo" Foreground="{DynamicResource ForegroundBrush}"
                               FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding EnvironmentPendingSummary}" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,3,12,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Retomar configuração" Command="{Binding OpenGuidedSetupCommand}"
                        Style="{StaticResource FluentButton}" Padding="18,9" VerticalAlignment="Center"
                        ToolTip="Abre a configuração guiada na primeira etapa pendente" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,22">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="CONEXÕES DISPONÍVEIS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalConnections}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="TÚNEIS ATIVOS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="ESTADO OPERACIONAL" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding OperationalStatus}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Active Resources" Style="{StaticResource SectionTitle}" />
                    <TextBlock HorizontalAlignment="Right" Text="Cada túnel usa uma porta local exclusiva"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" VerticalAlignment="Bottom" />
                </Grid>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="18,26" Margin="0,0,0,16"
                        Visibility="{Binding ActiveConnections.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="&#xE968;" Style="{StaticResource EmptyStateGlyph}" />
                        <TextBlock Text="Nenhum banco conectado" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Text="Escolha uma conexão no catálogo abaixo para abrir o primeiro túnel."
                                   Style="{StaticResource EmptyStateText}" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                        Visibility="{Binding ActiveConnections.Count, Converter={StaticResource CountToInvertedVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ActiveConnections}"
                              ItemTemplate="{StaticResource ActiveTunnelTemplate}"
                              >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </Border>

                <Grid Margin="0,8,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Resource Catalog" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SearchResultSummary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
                    <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Height="46">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                                     ToolTip="Busque por nome, ambiente, tipo, status, host ou porta" />
                            <TextBlock Grid.Column="1" Text="Buscar por banco, ambiente, tipo, status ou porta..."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" ToolTip="Limpar busca"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource NavigationButton}" Padding="0" Margin="4">
                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,12"
                        Visibility="{Binding HasCatalogMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="15" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding CatalogMessage}" Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                </Border>

                <ListView ItemsSource="{Binding FilteredConnections}"
                          ItemTemplate="{StaticResource ConnectionRowTemplate}"
                          Style="{StaticResource FluentListView}"
                          ItemContainerStyle="{StaticResource FluentListViewItem}">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="9" Margin="0,0,0,18" ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                            <Grid Margin="14,0">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundBrush}" FontSize="12" FontWeight="Bold" />
                                                                </StackPanel>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,3">
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} recursos}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter Grid.Row="1" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- Painel de dados da conexão. O Hoop não informa o database, então mostramos o
             banco de manutenção padrão e deixamos claro o que muda a cada túnel. -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="60"
              Visibility="{Binding IsConnectionGuideVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#99070B14" />
            <Border Width="620" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="26"
                    DataContext="{Binding ConnectionGuideTarget}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardIconBadge}" Width="42" Height="42" CornerRadius="11">
                            <TextBlock Text="&#xE968;" Style="{StaticResource CardIconGlyph}" FontSize="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DADOS DA CONEXÃO" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource NavigationButton}" Padding="0" Width="32" Height="32"
                                ToolTip="Fechar"
                                Command="{Binding DataContext.HideConnectionGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="HOST" Style="{StaticResource GuideFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Host}" Style="{StaticResource GuideFieldValue}" />
                                        <Button Grid.Column="2" Style="{StaticResource GuideCopyButton}"
                                                Command="{Binding DataContext.CopyHostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="PORTA" Style="{StaticResource GuideFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Port}" Style="{StaticResource GuideFieldValue}" />
                                        <Button Grid.Column="2" Style="{StaticResource GuideCopyButton}"
                                                Command="{Binding DataContext.CopyPortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="DATABASE" Style="{StaticResource GuideFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Database}" Style="{StaticResource GuideFieldValue}" />
                                        <Button Grid.Column="2" Style="{StaticResource GuideCopyButton}"
                                                Command="{Binding DataContext.CopyDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="USUÁRIO" Style="{StaticResource GuideFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Username}" Style="{StaticResource GuideFieldValue}" />
                                        <Button Grid.Column="2" Style="{StaticResource GuideCopyButton}"
                                                Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="SENHA" Style="{StaticResource GuideFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PasswordDisplay}" Style="{StaticResource GuideFieldValue}" />
                                        <Button Grid.Column="2" Style="{StaticResource GuideCopyButton}" ToolTip="Exibir ou ocultar"
                                                Command="{Binding TogglePasswordVisibilityCommand}">
                                            <TextBlock Text="{Binding PasswordVisibilityGlyph}" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource GuideCopyButton}"
                                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="URL JDBC" Style="{StaticResource GuideFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding JdbcUrl}" Style="{StaticResource GuideFieldValue}" ToolTip="{Binding JdbcUrl}" />
                                        <Button Grid.Column="2" Style="{StaticResource GuideCopyButton}"
                                                Command="{Binding DataContext.CopyJdbcUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PRIMEIRA VEZ NO DBEAVER" Style="{StaticResource EyebrowText}" Margin="2,20,0,12" />

                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource GuideStepBadge}"><TextBlock Text="1" Style="{StaticResource GuideStepNumber}" /></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource GuideStepText}"
                                           Text="No DBeaver, abra Database › New Database Connection e escolha PostgreSQL." />
                            </Grid>
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource GuideStepBadge}"><TextBlock Text="2" Style="{StaticResource GuideStepNumber}" /></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource GuideStepText}"
                                           Text="Preencha Host, Porta, Database e Usuário com os valores acima." />
                            </Grid>
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource GuideStepBadge}"><TextBlock Text="3" Style="{StaticResource GuideStepNumber}" /></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource GuideStepText}"
                                           Text="Cole a senha e deixe &quot;Save password&quot; desmarcado — ela vale só enquanto este túnel existir." />
                            </Grid>
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource GuideStepBadge}"><TextBlock Text="4" Style="{StaticResource GuideStepNumber}" /></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource GuideStepText}"
                                           Text="Marque &quot;Show all databases&quot; para navegar os demais bancos do servidor." />
                            </Grid>
                            <Grid Margin="2,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource GuideStepBadge}"><TextBlock Text="5" Style="{StaticResource GuideStepNumber}" /></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource GuideStepText}"
                                           Text="Use Test Connection para confirmar e conclua em Finish." />
                            </Grid>

                            <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="13,11" Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource WarningBrush}"
                                               FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" FontSize="11" LineHeight="17"
                                               Text="A porta e a senha valem apenas para este túnel: ao reconectar, confira os dados aqui antes de usar a conexão salva. O database mostrado é o banco de manutenção padrão — se o seu recurso usar outro, ajuste no DBeaver." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button Content="Copiar todos os dados" HorizontalAlignment="Left" Padding="18,9"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Copia host, porta, database, usuário, senha e URL de uma vez"
                                Command="{Binding DataContext.CopyConnectionSummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Fechar" HorizontalAlignment="Right" Padding="20,9"
                                Style="{StaticResource FluentButton}"
                                Command="{Binding DataContext.HideConnectionGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
