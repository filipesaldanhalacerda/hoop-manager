<UserControl x:Class="HoopConnectionManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}" />

        <DataTemplate x:Key="ActiveTunnelTemplate">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,13"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="178" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Degraded">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EnvironmentGroup}" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="  •  " Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="10" />
                            <TextBlock Text="{Binding ConnectionStateLabel}" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       FontSize="10" FontWeight="SemiBold" ToolTip="{Binding StatusDetail}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="ENDPOINT LOCAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding LocalEndpoint}" Foreground="{DynamicResource ForegroundBrush}"
                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="USUÁRIO" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Username}" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="DESDE" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConnectedAt, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="4,0,10,0">
                        <TextBlock Text="SENHA TEMPORÁRIA" Style="{StaticResource MetricLabel}" />
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Height="32" Margin="0,3,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PasswordDisplay}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="9,0,4,0" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{Binding TogglePasswordVisibilityCommand}" ToolTip="Exibir ou ocultar senha"
                                        Style="{StaticResource NavigationButton}" Padding="0" Margin="1">
                                    <TextBlock Text="{Binding PasswordVisibilityGlyph}" FontFamily="Segoe Fluent Icons" FontSize="13" HorizontalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2" ToolTip="Copiar senha temporária"
                                        Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource NavigationButton}" Padding="0" Margin="1">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Desconectar" ToolTip="Encerrar este túnel"
                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource DangerButton}" Padding="11,7" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ConnectionRowTemplate">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,14"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="17" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AMBIENTE" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding EnvironmentGroup}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="STATUS" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ConnectionStateLabel}" Foreground="{DynamicResource ForegroundBrush}"
                                   ToolTip="{Binding StatusDetail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="PORTA LOCAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding LocalEndpoint}"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Conectar"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanConnect}"
                                Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Desconectar"
                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanDisconnect}"
                                Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Resources" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="My Resources" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,13,0,0" />
                <TextBlock Text="Conecte bancos autorizados usando túneis locais seguros."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding CatalogSyncStatus}" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="16">
                <StackPanel><TextBlock Text="CONEXÕES DISPONÍVEIS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TotalConnections}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
                <StackPanel><TextBlock Text="TÚNEIS ATIVOS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding ConnectedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="16">
                <StackPanel><TextBlock Text="ESTADO OPERACIONAL" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding OperationalStatus}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,0" /></StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Active Resources" Style="{StaticResource SectionTitle}" />
                    <TextBlock HorizontalAlignment="Right" Text="Cada túnel usa uma porta local exclusiva"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" VerticalAlignment="Bottom" />
                </Grid>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,16"
                        Visibility="{Binding ActiveConnections.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <TextBlock Text="Nenhum banco conectado. Escolha uma conexão abaixo para abrir o primeiro túnel."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" HorizontalAlignment="Center" />
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                        Visibility="{Binding ActiveConnections.Count, Converter={StaticResource CountToInvertedVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ActiveConnections}"
                              ItemTemplate="{StaticResource ActiveTunnelTemplate}"
                              >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </Border>

                <Grid Margin="0,8,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Resource Catalog" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SearchResultSummary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" />
                    <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Height="46">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                                     ToolTip="Busque por nome, ambiente, tipo, status, host ou porta" />
                            <TextBlock Grid.Column="1" Text="Buscar por banco, ambiente, tipo, status ou porta..."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" ToolTip="Limpar busca"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource NavigationButton}" Padding="0" Margin="4">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,12"
                        Visibility="{Binding HasCatalogMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="15" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding CatalogMessage}" Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                </Border>

                <ListView ItemsSource="{Binding FilteredConnections}"
                          ItemTemplate="{StaticResource ConnectionRowTemplate}"
                          Style="{StaticResource FluentListView}"
                          ItemContainerStyle="{StaticResource FluentListViewItem}">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="9" Margin="0,0,0,18" ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                            <Grid Margin="14,0">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundBrush}" FontSize="12" FontWeight="Bold" />
                                                                </StackPanel>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,3">
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} recursos}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter Grid.Row="1" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
