<UserControl x:Class="HoopConnectionManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1050">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="PREFERÊNCIAS DO SISTEMA" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
                <TextBlock Text="Controle integrações, inicialização e aparência do aplicativo."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="INTEGRAÇÕES" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Executáveis detectados" Style="{StaticResource SectionHeading}" Margin="0,5,0,4" />
                            <TextBlock Text="Esses caminhos são usados para iniciar o Hoop e abrir o DBeaver após criar um túnel."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                            <TextBlock Text="Hoop CLI" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Executável responsável pela autenticação e pelos túneis locais."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" Margin="0,2,0,7" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding HoopExecutablePath}" Style="{StaticResource FluentTextBox}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                <Button Grid.Column="1" Content="Localizar" Command="{Binding BrowseHoopExecutableCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="DBeaver" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Cliente que será aberto automaticamente com o endpoint local."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" Margin="0,2,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DbeaverExecutablePath}" Style="{StaticResource FluentTextBox}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                <Button Grid.Column="1" Content="Localizar" Command="{Binding BrowseDBeaverExecutableCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="COMPORTAMENTO" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Automação" Style="{StaticResource SectionHeading}" Margin="0,5,0,14" />
                            <CheckBox Content="Iniciar o gerenciador com o Windows" IsChecked="{Binding StartWithWindows}"
                                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,6" />
                            <CheckBox Content="Continuar executando na bandeja ao fechar a janela" IsChecked="{Binding MinimizeToTray}"
                                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,6" />
                            <CheckBox Content="Abrir o DBeaver automaticamente após conectar" IsChecked="{Binding OpenDBeaverAutomatically}"
                                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,6" />
                            <CheckBox Content="Sincronizar o catálogo automaticamente a cada 5 minutos" IsChecked="{Binding RefreshConnectionsOnStartup}"
                                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,6" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="DIAGNÓSTICO SEGURO" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Ambiente Hoop" Style="{StaticResource SectionHeading}" Margin="0,5,0,6" />
                            <TextBlock Text="Informações não sensíveis obtidas pelos comandos oficiais. Tokens nunca são consultados."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="VERSÃO" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="1" Text="{Binding HoopVersion}" Foreground="{DynamicResource ForegroundBrush}"
                                           FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="GATEWAY" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="1" Text="{Binding HoopGateway}" Foreground="{DynamicResource ForegroundBrush}"
                                           FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="CONFIGURAÇÃO" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="1" Text="{Binding HoopConfigurationSource}" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="SESSÃO" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="1" Text="{Binding HoopAuthenticationStatus}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="{Binding HoopCompatibilityStatus}" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,2,0,14" />
                            <Button Content="Autenticar novamente" Command="{Binding ReauthenticateHoopCommand}"
                                    Style="{StaticResource FluentButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="APARÊNCIA" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Tema da interface" Style="{StaticResource SectionHeading}" Margin="0,5,0,6" />
                            <TextBlock Text="Use o tema do Windows ou escolha uma preferência fixa."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                      Style="{StaticResource FluentComboBox}" />
                            <TextBlock Text="A alteração é aplicada e salva imediatamente."
                                       Foreground="{DynamicResource SuccessBrush}" FontSize="10" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel>
                            <TextBlock Text="COMO FUNCIONA" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Fluxo de conexão" Style="{StaticResource SectionHeading}" Margin="0,5,0,12" />
                            <TextBlock Text="01  O Hoop abre um túnel seguro" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4" />
                            <TextBlock Text="02  Uma porta local exclusiva é reservada" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4" />
                            <TextBlock Text="03  O DBeaver usa esse endpoint local" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4" />
                            <TextBlock Text="Senhas temporárias permanecem somente em memória."
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,20,0,0">
            <Grid>
                <TextBlock Text="{Binding SaveStatus}"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center" />
                <Button Content="Salvar configurações" Command="{Binding SaveCommand}" Style="{StaticResource FluentButton}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
