<UserControl x:Class="HoopConnectionManager.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Assistente de Configuração"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,24" />

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Indicador de passos -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="1" Foreground="{DynamicResource ForegroundBrush}" Margin="8,0" />
                    <TextBlock Text="2" Foreground="{DynamicResource ForegroundBrush}" Margin="8,0" />
                    <TextBlock Text="3" Foreground="{DynamicResource ForegroundBrush}" Margin="8,0" />
                    <TextBlock Text="4" Foreground="{DynamicResource ForegroundBrush}" Margin="8,0" />
                    <TextBlock Text="5" Foreground="{DynamicResource ForegroundBrush}" Margin="8,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=1}">
                        <TextBlock Text="Etapa 1: Verificar instalação do Hoop"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Margin="0,0,0,16" />
                        <Button Content="Verificar Instalação"
                                Command="{Binding CheckInstallationCommand}"
                                Style="{StaticResource FluentButton}"
                                Margin="0,8" />
                        <TextBlock Text="Ou selecione o script oficial para instalar:"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Margin="0,16,0,8" />
                        <TextBox Text="{Binding InstallerScriptPath}"
                                 Style="{StaticResource FluentTextBox}"
                                 Margin="0,0,0,8" />
                        <Button Content="Instalar Hoop"
                                Command="{Binding InstallHoopCommand}"
                                Style="{StaticResource FluentButton}" />
                        <ProgressBar Value="{Binding InstallerProgress}"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,16,0,0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SurfaceSecondaryBrush}" />
                        <TextBox Text="{Binding InstallerLog}"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="120"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource FluentTextBox}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=2}">
                    <TextBlock Text="Etapa 2: Login no Hoop"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,16" />
                    <TextBlock Text="Clique abaixo para executar 'hoop login'. O navegador será aberto para autenticação."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="Realizar Login"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource FluentButton}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=3}">
                    <TextBlock Text="Etapa 3: Conexões"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,16" />
                    <TextBlock Text="As conexões serão carregadas automaticamente no Dashboard."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="Buscar Conexões"
                            Command="{Binding LoadConnectionsCommand}"
                            Style="{StaticResource FluentButton}"
                            Margin="0,0,0,8" />
                    <TextBlock Text="Aguarde enquanto as conexões são carregadas do Hoop."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=4}">
                    <TextBlock Text="Etapa 4: DBeaver"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,16" />
                    <TextBlock Text="Verifique se o DBeaver está instalado. Se necessário, localize-o manualmente nas configurações."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="Verificar DBeaver"
                            Command="{Binding CheckDBeaverCommand}"
                            Style="{StaticResource FluentButton}"
                            Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DbeaverPath}"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=5}">
                    <TextBlock Text="Etapa 5: Concluir"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,16" />
                    <TextBlock Text="Tudo pronto! Abra o Dashboard para começar."
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="Concluir"
                            Command="{Binding FinishCommand}"
                            Style="{StaticResource FluentButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                   Margin="0,16,0,0" />
    </Grid>
</UserControl>
