<UserControl x:Class="HoopConnectionManager.Views.SessionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1050">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="SESSÕES LOCAIS" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="Histórico de sessões" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
            <TextBlock Text="Acompanhe quando cada túnel iniciou, terminou e por que foi encerrado. Nenhuma senha é armazenada."
                       Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="ATIVAS AGORA" Style="{StaticResource EyebrowText}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveCount}" Foreground="{DynamicResource SuccessBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource MetricIconGlyph}" />
                        <TextBlock Text="ENCERRADAS" Style="{StaticResource EyebrowText}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource ForegroundBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="44" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}" CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Buscar por banco, porta ou motivo..." IsHitTestVisible="False" Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Style="{StaticResource NavigationButton}" Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="0" Margin="4"><TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12" /></Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="2.2*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="BANCO" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="INÍCIO" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="2" Text="TÉRMINO" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="3" Text="DURAÇÃO" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="4" Text="PORTA" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                        <TextBlock Grid.Column="5" Text="ENCERRAMENTO" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" FontSize="9" />
                    </Grid>
                </Border>
                <ListView Grid.Row="1" ItemsSource="{Binding FilteredEntries}" Style="{StaticResource FluentListView}" ItemContainerStyle="{StaticResource FluentListViewItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="2.2*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ConnectionName}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionName}" />
                            <TextBlock Grid.Column="1" Text="{Binding StartLabel}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" />
                            <TextBlock Grid.Column="2" Text="{Binding EndLabel}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Grid.Column="4" Text="{Binding PortLabel}" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource MonoFontFamily}" />
                            <TextBlock Grid.Column="5" Text="{Binding EndReason}" Foreground="{DynamicResource ForegroundSecondaryBrush}" TextWrapping="Wrap" FontSize="10" />
                        </Grid>
                    </Border></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <!-- A tabela ficava completamente vazia sem nenhuma explicação. -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredEntries.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE81C;" Style="{StaticResource EmptyStateGlyph}" />
                    <TextBlock Text="Nenhuma sessão para exibir" Style="{StaticResource EmptyStateTitle}" />
                    <TextBlock Text="O histórico registra cada túnel aberto, com início, término e motivo do encerramento."
                               Style="{StaticResource EmptyStateText}" MaxWidth="340" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Summary}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" Margin="2,11,0,0" />
    </Grid>
</UserControl>
