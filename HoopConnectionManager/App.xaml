<Application x:Class="HoopConnectionManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HoopConnectionManager"
             xmlns:vm="clr-namespace:HoopConnectionManager.ViewModels"
             xmlns:views="clr-namespace:HoopConnectionManager.Views"
             xmlns:converters="clr-namespace:HoopConnectionManager.Helpers.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <converters:CountToInvertedVisibilityConverter x:Key="CountToInvertedVisibilityConverter" />
            <converters:StepToVisibilityConverter x:Key="StepToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WizardViewModel}">
                <views:WizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
