<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Paleta escura (padrão) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFCC00" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />

    <Color x:Key="BackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="AccentColor">#0067C0</Color>

    <!-- Fonte -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, Microsoft Sans Serif</FontFamily>
    <system:Double x:Key="DefaultFontSize">14</system:Double>

</ResourceDictionary>
