<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- Control Room: base profunda, superfícies técnicas e acento ciano. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#07111D" />
    <SolidColorBrush x:Key="NavigationBrush" Color="#091521" />
    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#111D37" />
    <SolidColorBrush x:Key="NavigationForegroundBrush" Color="#F7F8FC" />
    <SolidColorBrush x:Key="NavigationMutedBrush" Color="#9CA7BE" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#101F2E" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#162A3C" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#1A3145" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F2F7FA" />
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#91A6B7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#315CAA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4773C4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#163D52" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#284257" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#18283A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1D3357" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7385" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#49212B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5C451" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#493C20" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#42D9A0" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#163F37" />

    <Color x:Key="BackgroundColor">#07111D</Color>
    <Color x:Key="SurfaceColor">#101F2E</Color>
    <Color x:Key="AccentColor">#315CAA</Color>

    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Bahnschrift, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
    <!-- Segoe Fluent Icons só existe no Windows 11. Sem o fallback para o Segoe MDL2
         Assets, que acompanha o Windows 10, todo glifo vira um quadrado vazio. -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <system:Double x:Key="DefaultFontSize">14</system:Double>
</ResourceDictionary>
